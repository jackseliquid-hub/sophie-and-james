{
  "name": "sophie-and-james-showcase",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/web"
  ],
  "scripts": {
    "dev": "cd packages/web && bun run dev",
    "build": "turbo build",
    "build:web": "cd packages/web && bun run build",
    "start": "bun packages/web/src/__server.ts",
    "lint": "bun run typecheck",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@libsql/client": "^0.17.2",
    "cloudflare": "^5.2.0",
    "pm2": "^7.0.1"
  }
}
